# Environment Variables Template
# Copy this file to .env for local development
# DO NOT commit the actual .env file to git!

# Google Gemini API Key (Required)
GEMINI_KEY=your_gemini_api_key_here

# Allowed CORS Origins (comma-separated for production)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Flask Debug Mode (True for development, False for production)
FLASK_DEBUG=True

# Port (optional, will use Render's PORT in production)
# PORT=5000

# Python Version (for Render)
PYTHON_VERSION=3.9.16
